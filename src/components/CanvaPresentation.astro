---
/**
 * Responsive Canva presentation embed.
 * Pass the design's public "view" URL; the embed URL is derived from it.
 */
interface Props {
  url: string;
  title: string;
  credit?: string;
}
const { url, title, credit } = Astro.props;
const base = url.split('?')[0];
const embed = `${base}?embed`;
const share = `${base}?utm_content=${base.split('/')[4]}&utm_campaign=designshare&utm_medium=embeds&utm_source=link`;
---
<figure class="canva">
  <div class="canva-frame">
    <iframe loading="lazy" src={embed} title={`${title} (Canva presentation)`} allowfullscreen allow="fullscreen"></iframe>
  </div>
  <figcaption>
    <span>{credit}</span>
    <a href={share} target="_blank" rel="noopener">Open in Canva ↗</a>
  </figcaption>
</figure>

<style>
  .canva { margin: 0; }
  .canva-frame {
    position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 14px;
    background: var(--graphite-soft); box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.55), 0 0 0 1px var(--line, rgba(0, 0, 0, 0.08));
  }
  iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  figcaption {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1rem;
    margin-top: 0.75rem; font-size: 0.85rem; color: var(--fg-muted);
  }
  figcaption a { color: var(--fg-accent); font-weight: 600; text-decoration: none; }
  figcaption a:hover { text-decoration: underline; }
</style>
