---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import commencement from '../assets/photos/commencement.jpg';
import japan from '../assets/photos/japan-osaka.jpg';
import texas from '../assets/photos/working-texas-roadhouse.jpg';
import AscentScene from './AscentScene.astro';

interface Chapter {
  label: string;
  title: string;
  body: string[];
  takeaway: string;
  /** Add a photo here when available (e.g. a childhood or family photo for chapters 1–2). */
  image?: ImageMetadata;
  alt?: string;
  caption?: string;
  position?: string;
  quote?: string;
  /** Short muted loop from /public/media (used instead of a photo). */
  video?: { src: string; poster: string; label: string };
}

const chapters: Chapter[] = [
  {
    label: 'The Foundation',
    title: 'Learning what it takes to build something.',
    body: [
      'Growing up, I had the opportunity to look up to my father, an entrepreneur and business owner. His example introduced me to the idea of building something of your own.',
      'What interested me was never the title or the authority that comes with owning a business. It was everything underneath it: the leadership, the responsibility, and the persistence and resilience it takes to make something successful. That is where my curiosity about entrepreneurship began.',
    ],
    takeaway: 'Ownership is less about the title and more about responsibility, persistence, and resilience.',
    quote: 'It was never about the title. It was about what it takes.',
    image: japan,
    alt: 'Hector smiling in a selfie at night in Osaka, Japan, beneath the illuminated Glico running-man sign.',
    caption: 'Exploring Osaka, Japan.',
    position: '50% 60%',
  },
  {
    label: 'Starting Over',
    title: 'A new country, a new language, a new beginning.',
    body: [
      'After my father’s passing, I had the opportunity to move to the United States and begin a new life.',
      'That meant adapting to a different country, learning a new language, and navigating an unfamiliar system without an established support network. I chose not to let those challenges define my limits. I treated each one as an opportunity to develop.',
    ],
    takeaway: 'Circumstances can set the starting point. They don’t have to set the limit.',
    quote: 'Every unfamiliar system was something new to learn.',
    image: texas,
    alt: 'Hector in his Texas Roadhouse uniform, giving a thumbs-up in a mirror selfie.',
    caption: 'On shift at Texas Roadhouse.',
    position: '50% 32%',
  },
  {
    label: 'Building Through Action',
    title: 'Learning by doing, one shift and one semester at a time.',
    body: [
      'My path has meant balancing college, work, and personal development while adapting to a new environment. Working while pursuing higher education taught me responsibility, consistency, time management, communication, and perseverance.',
      'I believe opportunities exist for people willing to learn, take initiative, and work toward their goals, and that no one should let their current circumstances, or their current salary, define what they can eventually build.',
    ],
    takeaway: 'Consistency compounds. Steady action builds momentum that circumstances can’t take away.',
    image: commencement,
    alt: 'Hector smiling in a cap and gown, taking a selfie with fellow graduates at commencement.',
    caption: 'Commencement, Class of 2026.',
    position: '30% 50%',
  },
  {
    label: 'Turning Ambition Into Strategy',
    title: 'Why finance.',
    body: [
      'My interest in finance comes from wanting to understand how financial knowledge can turn ambitions into realistic plans and actions.',
      'To me, finance is more than numbers. It is a way to understand decisions, evaluate opportunities, allocate resources, and help people build better futures. That is the direction I want to pursue: combining financial knowledge with strategic business thinking to contribute to meaningful outcomes.',
    ],
    takeaway: 'Ambition becomes progress when there is a plan behind it.',
    video: {
      src: '/media/excel-analysis.mp4',
      poster: '/media/excel-analysis-poster.jpg',
      label: 'Hector working on a financial spreadsheet in Excel on his laptop.',
    },
    caption: 'Putting it into practice: analysis in Excel.',
  },
];
---
<section id="evolution" class="section theme-dark evolution" aria-labelledby="evo-title">
  <div class="wrap">
    <header class="section-head split">
      <div>
        <p class="eyebrow reveal">My evolution</p>
        <h2 id="evo-title" class="section-title reveal" style="--d:.08s">
          Building from zero. <span class="serif accent">Thinking beyond limitations.</span>
        </h2>
      </div>
      <p class="lede reveal" style="--d:.16s">
        Four chapters that shaped how I think about business, work, and growth, from the example that sparked my
        curiosity to the direction I’m building toward now.
      </p>
    </header>

    <div class="evo-grid">
      <nav class="rail" aria-label="Chapters">
        <div class="rail-inner">
        <AscentScene />
        <ol>
          {chapters.map((c, i) => (
            <li data-rail-item class:list={{ current: i === 0 }}>
              <a href={`#chapter-${i + 1}`}>
                <span class="r-num">0{i + 1}</span>
                <span class="r-label">{c.label}</span>
              </a>
            </li>
          ))}
        </ol>
        </div>
      </nav>

      <div class="chapters">
        {chapters.map((c, i) => (
          <article id={`chapter-${i + 1}`} class="chapter" data-chapter={i} aria-labelledby={`ch-${i}-title`}>
            <div class="ch-text">
              <p class="ch-kicker reveal">
                <span class="ch-num">0{i + 1}</span> Chapter {i + 1} · {c.label}
              </p>
              <h3 id={`ch-${i}-title`} class="ch-title reveal" style="--d:.06s">{c.title}</h3>
              <div class="ch-body">
                {c.body.map((p) => <p class="reveal">{p}</p>)}
              </div>
              <aside class="takeaway reveal" aria-label="Takeaway">
                <span>Takeaway</span>
                <p>{c.takeaway}</p>
              </aside>
            </div>

            {c.video ? (
              <figure class="ch-media reveal">
                <div class="frame">
                  <video class="ambient" src={c.video.src} poster={c.video.poster} autoplay muted loop playsinline preload="metadata" aria-label={c.video.label}></video>
                </div>
                {c.caption && <figcaption>{c.caption}</figcaption>}
              </figure>
            ) : c.image ? (
              <figure class="ch-media reveal">
                <div class="frame parallax" data-parallax>
                  <Picture
                    src={c.image}
                    formats={['avif', 'webp']}
                    widths={[600, 1000]}
                    sizes="(min-width: 1000px) 560px, 92vw"
                    alt={c.alt ?? ''}
                    style={`object-position:${c.position ?? 'center'}`}
                  />
                </div>
                {c.caption && <figcaption>{c.caption}</figcaption>}
              </figure>
            ) : (
              <figure class="ch-quote reveal" aria-hidden="true">
                <span class="big-num">0{i + 1}</span>
                <blockquote class="serif">“{c.quote}”</blockquote>
              </figure>
            )}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .evolution { overflow: clip; }
  .evo-grid { display: grid; gap: 3rem; }
  @media (min-width: 1000px) { .evo-grid { grid-template-columns: 280px 1fr; gap: clamp(3rem, 5vw, 4.5rem); } }

  .rail { display: none; }
  @media (min-width: 1000px) {
    .rail { display: block; }
    .rail-inner { position: sticky; top: calc(var(--nav-h) + 2rem); display: grid; gap: 1.5rem; }
    .rail ol { list-style: none; padding: 0; margin: 0; border-left: 1px solid var(--line-dark); }
  }
  @media (min-width: 1000px) and (max-height: 760px) {
    .rail-inner :global(.ascent) { aspect-ratio: 1; }
    .rail a { padding-block: 0.5rem; }
  }
  .rail li { position: relative; }
  .rail li::before {
    content: ''; position: absolute; left: -1px; top: 0; bottom: 0; width: 2px;
    background: var(--blue); transform: scaleY(0); transform-origin: top; transition: transform 0.5s var(--ease);
  }
  .rail li.current::before, .rail li.done::before { transform: scaleY(1); }
  .rail li.done::before { background: rgba(52, 120, 246, 0.45); }
  .rail a { display: grid; gap: 0.15rem; padding: 0.65rem 0 0.65rem 1.25rem; text-decoration: none; color: #8d97a5; transition: color 0.3s; }
  .rail li.current a, .rail a:hover { color: var(--offwhite); }
  .r-num { font: 600 0.75rem var(--font-display); letter-spacing: 0.1em; color: inherit; }
  .rail li.current .r-num { color: var(--blue-glow); }
  .r-label { font: 500 0.95rem/1.3 var(--font-display); }

  .chapters { display: grid; }
  .chapter {
    display: grid; gap: clamp(2rem, 4vw, 4rem); align-items: center;
    padding-block: clamp(3rem, 7vw, 6rem);
    border-top: 1px solid var(--line-dark);
  }
  .chapter:first-child { border-top: 0; padding-top: 0; }
  @media (min-width: 1000px) { .chapter { min-height: 80vh; } }
  @media (min-width: 1200px) {
    .chapter { grid-template-columns: 1.05fr 0.95fr; }
    .chapter:nth-child(even) .ch-text { order: 2; }
  }
  .ch-kicker { display: flex; align-items: center; gap: 0.75rem; font: 600 0.8rem var(--font-display); letter-spacing: 0.12em; text-transform: uppercase; color: var(--steel); }
  .ch-num { color: var(--blue-glow); }
  .ch-title { font-size: var(--step-3); margin: 1rem 0 1.5rem; max-width: 18ch; }
  .ch-body { display: grid; gap: 1.1rem; color: #c9d0d9; font-size: 1.075rem; line-height: 1.75; max-width: 56ch; }
  .takeaway {
    margin-top: 2rem; padding: 1.1rem 1.25rem; border-radius: 12px; max-width: 56ch;
    background: rgba(52, 120, 246, 0.08); border: 1px solid rgba(52, 120, 246, 0.3);
  }
  .takeaway span { display: block; font: 600 0.72rem var(--font-display); letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue-glow); margin-bottom: 0.35rem; }
  .takeaway p { font: 500 1.08rem/1.5 var(--font-display); color: var(--offwhite); }

  .ch-media { margin: 0; }
  .ch-media .frame { aspect-ratio: 4 / 5; border-radius: 18px; }
  @media (max-width: 1199px) { .ch-media, .ch-quote { max-width: 460px; } }
  @media (min-width: 1000px) and (max-height: 820px) { .ch-media .frame { aspect-ratio: 1; } }
  .parallax :global(img) { transform: translateY(var(--py, 0)) scale(1.12); will-change: transform; }
  .ambient { width: 100%; height: 100%; object-fit: cover; }
  .ch-media figcaption { margin-top: 0.75rem; font-size: 0.85rem; color: #8d97a5; }

  .ch-quote {
    margin: 0; position: relative; aspect-ratio: 4 / 5; border-radius: 18px; padding: clamp(1.75rem, 4vw, 3rem);
    display: flex; flex-direction: column; justify-content: flex-end;
    background:
      radial-gradient(120% 80% at 100% 0%, rgba(52, 120, 246, 0.22), transparent 60%),
      linear-gradient(160deg, #262b33, #1a1d23);
    border: 1px solid var(--line-dark); overflow: hidden;
  }
  @media (max-width: 999px) { .ch-quote { aspect-ratio: auto; min-height: 260px; } }
  .big-num {
    position: absolute; top: -0.12em; right: 0.05em; font: 700 clamp(9rem, 20vw, 16rem)/1 var(--font-display);
    letter-spacing: -0.06em; color: transparent; -webkit-text-stroke: 1px rgba(165, 175, 188, 0.25);
  }
  .ch-quote blockquote { margin: 0; font-size: var(--step-2); line-height: 1.2; color: var(--offwhite); max-width: 16ch; position: relative; }
</style>
