---
import { Picture } from 'astro:assets';
import portrait from '../assets/photos/hero-headshot.jpg';
import Icon from './Icon.astro';
import HeroGlobe from './HeroGlobe.astro';
import { profile } from '../data/site';

const journey = [
  { year: '2021', label: 'Problem Solver, Amazon' },
  { year: '2023', label: 'Real estate marketing' },
  { year: '2024', label: 'Shift Leader, Panda' },
  { year: '2026', label: 'A.B.A., Pima · ACE 1st place' },
  { year: 'Now', label: 'Finance at Eller', now: true },
  { year: '2027', label: 'B.S.B.A. Finance (expected)' },
];
---
<section id="home" class="hero theme-dark theme-deep" aria-labelledby="hero-title">
  <div class="glow" aria-hidden="true"></div>
  <div class="grid-lines" aria-hidden="true"></div>
  <HeroGlobe />

  <div class="wrap hero-grid">
    <div class="copy">
      <p class="eyebrow load" style="--i:0">Finance · Eller College of Management</p>
      <h1 id="hero-title" class="headline">
        <span class="load" style="--i:1">{profile.headline[0]}</span>
        <span class="load" style="--i:2">{profile.headline[1]}</span>
        <span class="load serif accent" style="--i:3">{profile.headline[2]}</span>
      </h1>
      <p class="intro load" style="--i:4">
        I’m a Finance student at the University of Arizona’s Eller College of Management, interested in how financial
        knowledge and strategic thinking can turn opportunities into meaningful business outcomes. My experiences across
        operations, leadership, customer service, marketing, and academic projects have shaped the way I approach
        challenges and work with people.
      </p>
      <div class="ctas load" style="--i:5">
        <a class="btn btn-primary" href="#resume">View My Résumé <Icon name="arrow" /></a>
        <a class="btn btn-ghost" href="#work">Explore My Work</a>
        <a class="btn btn-ghost" href={profile.linkedin} target="_blank" rel="noopener">
          <Icon name="linkedin" /> Connect on LinkedIn
        </a>
        <a class="btn btn-ghost" href="#contact">Contact Me</a>
      </div>
      <a class="intro-link load" style="--i:6" href="#intro-video">
        <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg></span>
        Watch my introduction video
      </a>
    </div>

    <figure class="portrait load" style="--i:2">
      <div class="portrait-frame">
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          widths={[420, 720, 960]}
          sizes="(min-width: 1000px) 420px, 80vw"
          alt="Portrait of Hector Maytorena Abreu in a navy suit and lavender tie."
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption class="badge">
        <span class="badge-k">1st Place</span>
        <span class="badge-v">ACE Case Competition 2026</span>
      </figcaption>
      <div class="meta-chip" aria-hidden="true">
        <span class="dot"></span> Open to internships · FP&A · Corporate finance
      </div>
    </figure>
  </div>

  <div class="wrap">
    <ol class="journey load" style="--i:6" aria-label="Journey so far">
      {journey.map((j) => (
        <li class:list={{ now: j.now }}>
          <span class="j-year">{j.year}</span>
          <span class="j-label">{j.label}</span>
        </li>
      ))}
    </ol>
  </div>

  <a class="scroll-cue" href="#about" aria-label="Scroll to About">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    min-height: 100svh; display: flex; flex-direction: column; justify-content: center;
    padding: calc(var(--nav-h) + clamp(2rem, 6vw, 4rem)) 0 clamp(3rem, 6vw, 5rem);
  }
  .glow {
    position: absolute; z-index: -1; width: 70vw; height: 70vw; right: -20vw; top: -25vw;
    background: radial-gradient(closest-side, rgba(52, 120, 246, 0.28), transparent 70%);
    filter: blur(10px);
  }
  .grid-lines {
    position: absolute; inset: 0; z-index: -1; opacity: 0.5;
    background-image: linear-gradient(to right, rgba(165, 175, 188, 0.07) 1px, transparent 1px);
    background-size: calc(100% / 6) 100%;
    mask-image: linear-gradient(to bottom, #000 0%, transparent 85%);
  }
  .hero-grid { display: grid; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  @media (min-width: 1000px) { .hero-grid { grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.8fr); } }

  .headline { font-size: clamp(2.5rem, 1.2rem + 4.6vw, 5.75rem); font-weight: 650; letter-spacing: -0.035em; line-height: 0.98; margin: 1.5rem 0 1.75rem; }
  .headline span { display: block; }
  @media (min-width: 420px) { .headline span { white-space: nowrap; } }
  .headline .serif { font-weight: 400; letter-spacing: -0.02em; padding-right: 0.1em; }
  .intro { color: var(--fg-muted); font-size: var(--step-1); line-height: 1.6; max-width: 58ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 2.25rem; }

  .portrait { position: relative; margin: 0; max-width: 420px; width: 100%; justify-self: center; }
  .portrait-frame {
    aspect-ratio: 4 / 5; border-radius: 22px; overflow: hidden; position: relative;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .portrait-frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
  .intro-link { display: inline-flex; align-items: center; gap: 0.75rem; margin-top: 1.5rem; color: var(--offwhite); font: 600 0.95rem var(--font-display); text-decoration: none; }
  .intro-link:hover { color: var(--blue-glow); }
  .play { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--line-dark); background: rgba(255,255,255,0.06); }
  .play svg { width: 14px; margin-left: 2px; }
  .portrait-frame::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(22, 25, 30, 0.55));
  }
  .badge {
    position: absolute; left: -1.25rem; bottom: 2rem; display: grid; gap: 0.1rem;
    padding: 0.85rem 1.1rem; border-radius: 14px;
    background: rgba(32, 36, 43, 0.82); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--line-dark);
  }
  .badge-k { font: 700 1.25rem/1.1 var(--font-display); color: #fff; }
  .badge-v { font-size: 0.8rem; color: #b9c1cc; }
  .meta-chip {
    position: absolute; right: -0.75rem; top: 1.5rem; display: flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.85rem; border-radius: 999px; font-size: 0.75rem; font-weight: 500;
    background: var(--offwhite); color: var(--graphite); box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #2fbf71; box-shadow: 0 0 0 3px rgba(47, 191, 113, 0.25); }
  @media (max-width: 520px) {
    .badge { left: 0.75rem; bottom: 0.75rem; }
    .meta-chip { right: 0.5rem; top: 0.75rem; font-size: 0.7rem; }
  }

  .journey {
    list-style: none; padding: 0; margin: clamp(3rem, 7vw, 5rem) 0 0;
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr));
    border-top: 1px solid var(--line-dark);
  }
  .journey li { position: relative; padding: 1.1rem 1rem 0 0; display: grid; gap: 0.25rem; }
  .journey li::before {
    content: ''; position: absolute; top: -4px; left: 0; width: 7px; height: 7px; border-radius: 50%;
    background: var(--steel);
  }
  .journey li.now::before { background: var(--blue); box-shadow: 0 0 0 5px rgba(52, 120, 246, 0.25); }
  .j-year { font: 600 0.8rem var(--font-display); letter-spacing: 0.08em; text-transform: uppercase; color: var(--steel); }
  .now .j-year { color: var(--blue-glow); }
  .j-label { font-size: 0.88rem; color: #d5dae1; line-height: 1.4; }
  @media (max-width: 900px) {
    .journey { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 46%; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 0.5rem; scrollbar-width: none; }
    .journey li { scroll-snap-align: start; }
  }

  .scroll-cue {
    position: absolute; left: 50%; bottom: 1.25rem; translate: -50% 0;
    width: 26px; height: 42px; border: 1.5px solid rgba(165, 175, 188, 0.5); border-radius: 20px;
    display: none;
  }
  .scroll-cue span {
    position: absolute; left: 50%; top: 8px; width: 3px; height: 8px; margin-left: -1.5px; border-radius: 3px;
    background: var(--steel); animation: cue 2s var(--ease) infinite;
  }
  @keyframes cue { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(14px); } }
  @media (min-width: 1000px) and (min-height: 820px) { .scroll-cue { display: block; } }

  /* entrance */
  .load { animation: rise 1s var(--ease) both; animation-delay: calc(var(--i) * 90ms + 100ms); }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  /* The headline and intro are the largest paint: slide them in, but never hide them. */
  .headline .load, .intro.load { animation-name: slide; }
  @keyframes slide { from { transform: translateY(14px); } to { transform: none; } }
</style>
