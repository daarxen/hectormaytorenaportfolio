---
/**
 * Abstract Spline globe used as a blurred background layer inside the hero.
 * Spline file: “Globe”. Objects the script drives:
 *   Globe Spin (id c4b0b34b…, rotates on its axis), Orbit Spin 1 / Orbit Spin 2 (satellites).
 * Desktop/tablet only; skipped for reduced motion, data-saver, or no scene URL.
 */
import { spline } from '../data/site';
---
<div class="hero-globe" aria-hidden="true" data-globe data-scene={spline.globeUrl}>
  <canvas></canvas>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-globe]');
  const url = root?.dataset.scene;
  const canvas = root?.querySelector('canvas');

  const wants3D = () =>
    !!url &&
    window.matchMedia('(min-width: 768px)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
    !(navigator as any).connection?.saveData;

  async function boot() {
    if (!root || !canvas || !url) return;
    const { Application } = await import('@splinetool/runtime');
    const app = new Application(canvas, { renderMode: 'continuous', renderer: 'webgl' });
    await app.load(url);
    root.classList.add('ready');

    // Look up by id: the scene root also carries the name “Globe Spin”.
    const spin = app.findObjectById('c4b0b34b-dbee-4041-aa1e-501b7a611d27') ?? app.findObjectByName('Globe Spin');
    const orbits = [app.findObjectByName('Orbit Spin 1'), app.findObjectByName('Orbit Spin 2')];
    const deg = Math.PI / 180;
    let visible = true;
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && app.isStopped) app.play();
      else if (!visible && !app.isStopped) app.stop();
    }).observe(root);

    const tick = (now: number) => {
      if (visible) {
        const t = now / 1000;
        // slow spin + a little extra turn as the visitor scrolls past the hero
        const scrollTurn = Math.min(window.scrollY, window.innerHeight) / window.innerHeight;
        if (spin) spin.rotation.y = (t * 6 + scrollTurn * 40) * deg;
        if (orbits[0]) orbits[0].rotation.y = t * 9 * deg;
        if (orbits[1]) orbits[1].rotation.y = -t * 6 * deg;
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  if (root && wants3D()) {
    // Start ~3 s after the page has fully loaded, then wait for an idle moment, so
    // the 3D setup never competes with the first paint or the visitor's first clicks.
    const start = () => boot().catch(() => root.classList.remove('ready'));
    const idle = () =>
      'requestIdleCallback' in window ? (window as any).requestIdleCallback(start, { timeout: 2000 }) : start();
    const kick = () => setTimeout(idle, 3000);
    if (document.readyState === 'complete') kick();
    else window.addEventListener('load', kick, { once: true });
  }
</script>

<style>
  /* Anchored to the hero's bottom-right so Spline's "Built with Spline" badge
     (drawn in the canvas's bottom-right corner) always stays visible and sharp. */
  .hero-globe {
    position: absolute; z-index: -1; pointer-events: none;
    width: min(1150px, 90vw); aspect-ratio: 1;
    right: 0; bottom: 0;
    /* fade only the top and left edges */
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 28%), linear-gradient(to bottom, transparent 0, #000 30%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent 0, #000 28%), linear-gradient(to bottom, transparent 0, #000 30%);
    mask-composite: intersect;
  }
  .hero-globe canvas {
    width: 100%; height: 100%; display: block;
    opacity: 0; transition: opacity 1.6s var(--ease);
  }
  .hero-globe.ready canvas { opacity: 1; }
  /* frosted layer over the globe (only once it has loaded), stopping short of the badge strip */
  .hero-globe.ready::after {
    content: ''; position: absolute; inset: 0 0 76px 0;
    -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px);
    -webkit-mask-image: linear-gradient(to bottom, #000 88%, transparent);
    mask-image: linear-gradient(to bottom, #000 88%, transparent);
  }
  /* phones never load the globe: skip the layer entirely */
  @media (max-width: 767px) { .hero-globe { display: none; } }
</style>
