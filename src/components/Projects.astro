---
import { Picture } from 'astro:assets';
import { projects, upcoming } from '../data/projects';
import Icon from './Icon.astro';

const [featured, ...rest] = projects;
---
<section id="work" class="section theme-dark" aria-labelledby="work-title">
  <div class="wrap">
    <header class="section-head split">
      <div>
        <p class="eyebrow reveal">Projects &amp; portfolio</p>
        <h2 id="work-title" class="section-title reveal" style="--d:.08s">
          Evidence over <span class="serif accent">adjectives.</span>
        </h2>
      </div>
      <p class="lede reveal" style="--d:.16s">
        Competitions, strategy work and real-world projects. Each one breaks down the challenge, my role, what I did, and
        what came of it, including what was a team effort and what was mine.
      </p>
    </header>

    <a class="featured reveal" href={`/work/${featured.slug}/`}>
      <div class="f-media">
        {featured.cover && (
          <Picture
            src={featured.cover}
            formats={['avif', 'webp']}
            widths={[700, 1200, 1600]}
            sizes="(min-width: 1000px) 60vw, 100vw"
            alt={featured.coverAlt ?? ''}
            style={`object-position:${featured.coverPosition ?? 'center'}`}
          />
        )}
      </div>
      <div class="f-body">
        <p class="f-rank"><span>1st</span> Place</p>
        <p class="kicker">{featured.kicker} · {featured.mode}</p>
        <h3>{featured.title}</h3>
        <p class="summary">{featured.summary}</p>
        <ul class="tags">
          {featured.skills.slice(0, 4).map((s) => <li class="tag">{s}</li>)}
        </ul>
        <span class="link-arrow">Read the case study <Icon name="arrow" /></span>
      </div>
    </a>

    <ul class="cards">
      {rest.map((p, i) => (
        <li class="reveal" style={`--d:${i * 0.08}s`}>
          <a class="card" href={`/work/${p.slug}/`}>
            <div class="c-media">
              {p.cover ? (
                <Picture
                  src={p.cover}
                  formats={['avif', 'webp']}
                  widths={[500, 900]}
                  sizes="(min-width: 1000px) 30vw, (min-width: 640px) 50vw, 100vw"
                  alt={p.coverAlt ?? ''}
                  style={`object-position:${p.coverPosition ?? 'center'}`}
                />
              ) : (
                <div class="c-type" aria-hidden="true">
                  <span>{p.index}</span>
                </div>
              )}
            </div>
            <div class="c-body">
              <p class="kicker">{p.kicker}</p>
              <h3>{p.title}</h3>
              <p class="summary">{p.summary}</p>
              <p class="mode">{p.mode}</p>
              <span class="link-arrow">View project <Icon name="arrow" /></span>
            </div>
          </a>
        </li>
      ))}
      <li class="reveal" style="--d:.24s">
        <div class="card upcoming">
          <div class="c-body">
            <p class="kicker">In progress</p>
            <h3>{upcoming.title}</h3>
            <p class="summary">{upcoming.summary}</p>
            <p class="mode">Coming soon</p>
          </div>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .featured {
    display: grid; text-decoration: none; border-radius: 22px; overflow: hidden;
    background: var(--graphite-soft); border: 1px solid var(--line-dark);
    transition: border-color 0.3s var(--ease), transform 0.4s var(--ease);
  }
  @media (min-width: 1000px) { .featured { grid-template-columns: 1.3fr 1fr; min-height: 520px; } }
  .featured:hover { border-color: rgba(52, 120, 246, 0.6); }
  .f-media { overflow: hidden; aspect-ratio: 4 / 3; }
  @media (min-width: 1000px) { .f-media { aspect-ratio: auto; } }
  .f-media :global(img), .c-media :global(img) {
    width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease);
  }
  .featured:hover .f-media :global(img), .card:hover .c-media :global(img) { transform: scale(1.04); }
  .f-body { padding: clamp(1.75rem, 4vw, 3rem); display: flex; flex-direction: column; gap: 1rem; justify-content: center; }
  .f-rank { font: 700 var(--step-4)/0.9 var(--font-display); letter-spacing: -0.04em; display: flex; align-items: baseline; gap: 0.6rem; }
  .f-rank span { color: var(--blue-glow); }
  .f-rank { font-size: clamp(2.2rem, 4vw, 3.4rem); }
  .kicker { font: 600 0.75rem var(--font-display); letter-spacing: 0.12em; text-transform: uppercase; color: var(--steel); }
  .featured h3 { font-size: var(--step-2); }
  .summary { color: var(--fg-muted); line-height: 1.65; }
  .featured .link-arrow { margin-top: 0.5rem; }

  .cards { list-style: none; display: grid; gap: 1.25rem; margin-top: 1.25rem; }
  @media (min-width: 640px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .card {
    height: 100%; display: flex; flex-direction: column; text-decoration: none; border-radius: 18px; overflow: hidden;
    background: var(--graphite-soft); border: 1px solid var(--line-dark); transition: border-color 0.3s var(--ease), transform 0.4s var(--ease);
  }
  a.card:hover { border-color: rgba(52, 120, 246, 0.6); transform: translateY(-3px); }
  .c-media { aspect-ratio: 16 / 9; overflow: hidden; }
  .c-type {
    height: 100%; display: grid; place-items: end start; padding: 1.25rem;
    background: radial-gradient(120% 90% at 100% 0%, rgba(52, 120, 246, 0.35), transparent 60%), linear-gradient(160deg, #2c323c, #1c2026);
  }
  .c-type span { font: 700 5rem/0.8 var(--font-display); letter-spacing: -0.05em; color: transparent; -webkit-text-stroke: 1px rgba(165, 175, 188, 0.45); }
  .c-body { padding: 1.5rem; display: flex; flex-direction: column; gap: 0.7rem; flex: 1; }
  .c-body h3 { font-size: var(--step-1); }
  .c-body .summary { font-size: 0.95rem; }
  .mode { font-size: 0.82rem; color: var(--steel); margin-top: auto; padding-top: 0.5rem; }
  .upcoming { background: transparent; border-style: dashed; justify-content: center; min-height: 220px; }
</style>
