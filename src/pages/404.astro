---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="nf theme-dark theme-deep">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>This page doesn’t exist <span class="serif accent">yet.</span></h1>
      <a class="btn btn-primary" href="/">Back to home</a>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 80svh; display: grid; align-items: center; padding-top: var(--nav-h); color: var(--offwhite); }
  h1 { font-size: var(--step-4); margin: 1.25rem 0 2rem; max-width: 16ch; }
</style>
